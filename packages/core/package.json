{
  "name": "@household-budget/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript domain logic: CSV parsing, categorization rules, budget math. No framework dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=dot",
    "test:fast": "vitest run --reporter=dot --bail=1",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
