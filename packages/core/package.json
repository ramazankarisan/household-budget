{
  "name": "@household-budget/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript domain logic: CSV parsing, categorization rules, budget math. No framework dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./csv": {
      "types": "./dist/csv/index.d.ts",
      "default": "./dist/csv/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=dot",
    "test:fast": "vitest run --reporter=dot --bail=1",
    "test:coverage": "vitest run --reporter=dot --coverage",
    "mutation": "stryker run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "csv-parse": "^7.0.2"
  }
}
