{
  "name": "@household-budget/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS REST API for household-budget, backed by SQLite via Prisma.",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=dot",
    "test:fast": "vitest run --reporter=dot --bail=1",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@household-budget/core": "workspace:*",
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.2",
    "prisma": "^7.10.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  }
}
