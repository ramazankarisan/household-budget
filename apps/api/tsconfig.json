{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2023"],
    "types": ["node"],

    /* NestJS dependency injection reads design:paramtypes at runtime. */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
