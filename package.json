{
  "name": "household-budget",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "core:build": "pnpm --filter @household-budget/core build",
    "dev": "pnpm core:build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm core:build && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:deps": "depcruise packages/core/src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm core:build && pnpm -r test",
    "test:fast": "pnpm core:build && pnpm --filter @household-budget/core --filter @household-budget/api test:fast",
    "test:e2e": "pnpm core:build && node scripts/reset-e2e-db.mjs && pnpm --filter @household-budget/web exec playwright test",
    "e2e:install": "pnpm --filter @household-budget/web exec playwright install chromium",
    "check": "node scripts/check.mjs",
    "check:all": "node scripts/check.mjs --all",
    "prepare": "lefthook install",
    "clean": "pnpm -r exec rm -rf dist node_modules/.vite && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
