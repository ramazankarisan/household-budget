          "BIC (SWIFT-Code)": "SOLADEST600",
          "Betrag": "88,40",
          "Waehrung": "EUR",
          "Info": "Umsatz gebucht",
          "Kategorie": "Einkommen"
        }
      ],
      "_why": "an overlapping later export: the pending row now booked with a shifted date, the two identical rows again, one genuinely new row. This is what proves dedup."
    },
    {
      "suffix": "-malformed",
      "encoding": "utf-8",
      "onlyRows": [0],
      "blankAfterRow": [],
      "appendRaw": "DE89370400440532013000;\"22.09.25\";\"eins;zwei\r\n",
      "_why": "an unterminated quote: csv-parse must throw rather than swallow the rest of the file"
    }
  ]
