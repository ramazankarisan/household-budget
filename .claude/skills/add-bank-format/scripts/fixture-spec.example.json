  "variants": [
    {
      "suffix": "",
      "encoding": "cp1252",
      "_why": "what the bank really ships; only apps/api and the e2e read this one"
    },
    {
      "suffix": "-utf8",
      "encoding": "utf-8",
      "_why": "core reads fixtures through Vite's ?raw, which decodes as UTF-8"
    },
    {
      "suffix": "-utf8-bom",
      "encoding": "utf-8",
      "bom": true,
      "_why": "proves the BOM is stripped rather than glued to the first column name"
    },
    {
      "suffix": "-narrow",
      "encoding": "utf-8",
      "dropColumns": ["Kategorie"],
      "_why": "the bank's other column count, same rows: the test that both shapes produce identical transactions is what stops an index-based parser"
    },
    {
      "suffix": "-bad-rows",
      "encoding": "utf-8",
      "blankAfterRow": [],
      "onlyRows": [0, 1, 4, 5, 8],
      "patch": [
        {
          "row": 1,
          "set": {
            "Betrag": "12,3,4"
          }
        },
        {
          "row": 5,
          "set": {
            "Buchungstag": "32.13.25"
          }
        },
        {
          "row": 8,
          "set": {
            "Info": "Umsatz storniert"
          }
        }
      ],
      "_why": "one defect per row, one row per failure mode; every other row must still import"
    },
    {
      "suffix": "-next",
      "encoding": "cp1252",
      "onlyRows": [1, 2, 7],
      "blankAfterRow": [],
      "patch": [
        {
          "row": 7,
          "set": {
            "Buchungstag": "23.09.25",
            "Info": "Umsatz gebucht"
          }
        }
      ],
      "appendRows": [
        {
          "Auftragskonto": "DE89370400440532013000",
          "Buchungstag": "24.09.25",
          "Valutadatum": "15.09.25",
          "Buchungstext": "LOHN/GEHALT",
          "Verwendungszweck": "Erstattung Reisekosten",
          "Beguenstigter/Zahlungspflichtiger": "Beispiel AG",
