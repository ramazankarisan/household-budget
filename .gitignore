# --- tooling output ------------------------------------------------------
node_modules/
.pnpm-store
dist
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
*.tsbuildinfo
.eslintcache
.npm
*.tgz
coverage/
*.lcov

# Logs and Node diagnostic reports (https://nodejs.org/api/report.html)
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# dotenv environment variable files
.env
.env.*
!.env.example

# Editors and OS
.DS_Store
.idea/
.vscode/

# A local gitleaks run with --report-path. CI writes results.sarif (below).
gitleaks-report.json

# --- household-budget ---------------------------------------------------
# Local data and SQLite databases (never commit a developer's budget data).
# `data/` is unanchored on purpose: a database folder created from any working directory
# is caught, not only apps/api's.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Bank CSV exports. Synthetic test data under fixtures/ is the one exception,
# and scripts/check-staged-data.mjs blocks the rest at commit time.
#
# The negation is **/fixtures/, not fixtures/: a pattern containing a slash is
# anchored to this file's directory, so `!fixtures/**/*.csv` would re-include only a
# root-level fixtures/ while scripts/check-staged-data.mjs allows fixtures/ at any
# depth. That mismatch silently keeps packages/core/fixtures/*.csv out of git.
*.csv
!**/fixtures/**/*.csv

# Output of an exploratory (dogfood) session: notes and screenshots that can show local data.
# Findings worth keeping are summarised by hand under docs/reports/.
dogfood-output/

# Playwright output
test-results/
playwright-report/
blob-report/

# Prisma client is generated on install, not committed
apps/api/src/generated/

# Crash dumps at the repo root. Anchored with a leading slash so this does
# NOT match packages/core.
/core
/core.*

# Claude Code: personal settings and the status-line script they point at.
# Shared project settings would live in .claude/settings.json, which stays tracked.
.claude/settings.local.json
.claude/statusline-command.sh

# Throwaway git worktrees the agent harness creates. They are checkouts of this same
# repo, so committing them would nest the repository inside itself.
.claude/worktrees/

# Stryker mutation testing (packages/core): sandbox copies and the HTML report.
.stryker-tmp/
packages/core/reports/

# Written into the checkout by gitleaks-action in CI.
results.sarif
